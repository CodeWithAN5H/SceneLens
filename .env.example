# Optional development overrides. The Settings dialog stores keys outside the
# repository (%APPDATA%\SceneLens\config.json on Windows). Never commit .env.

# Any OpenAI-compatible multimodal endpoint.
SCENELENS_VISION_API_KEY=
SCENELENS_VISION_BASE_URL=https://api.openai.com/v1
SCENELENS_VISION_MODEL=gpt-4o-mini

# OPENAI_API_KEY is also accepted as a fallback.

# Optional: free TMDB key for posters and canonical film metadata.
SCENELENS_TMDB_API_KEY=
